<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#281829"/><corners android:radius="17dp"/><stroke android:width="1dp" android:color="#FF4A9F"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><gradient android:angle="0" android:startColor="#231725" android:endColor="#15121A"/><corners android:radius="17dp"/><stroke android:width="1dp" android:color="#8B326A"/></shape>
    </item>
</selector>
