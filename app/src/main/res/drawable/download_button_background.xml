<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><solid android:color="#49434F"/><corners android:radius="16dp"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><gradient android:angle="0" android:startColor="#C01776" android:endColor="#8F2BE8"/><corners android:radius="16dp"/><stroke android:width="1dp" android:color="#FF8BC4"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><gradient android:angle="0" android:startColor="#FF2D87" android:endColor="#B22CF3"/><corners android:radius="16dp"/><stroke android:width="1dp" android:color="#FF78B6"/></shape>
    </item>
</selector>
