<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#191520" android:endColor="#121018" />
            <corners android:radius="23dp" />
            <stroke android:width="1dp" android:color="#FF3D9A" />
            <padding android:left="14dp" android:top="4dp" android:right="14dp" android:bottom="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#17151D" android:endColor="#0F0E14" />
            <corners android:radius="23dp" />
            <stroke android:width="1dp" android:color="#3A3245" />
            <padding android:left="14dp" android:top="4dp" android:right="14dp" android:bottom="4dp" />
        </shape>
    </item>
</selector>
