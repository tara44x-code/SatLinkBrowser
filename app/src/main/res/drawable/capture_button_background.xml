<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#D41476" android:centerColor="#DB1FD0" android:endColor="#7C3AED" android:angle="0" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#FF8FC8" />
            <padding android:left="12dp" android:right="12dp" android:top="3dp" android:bottom="3dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FF2D72" android:centerColor="#F21AB3" android:endColor="#A855F7" android:angle="0" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#FF79B7" />
            <padding android:left="12dp" android:right="12dp" android:top="3dp" android:bottom="3dp" />
        </shape>
    </item>
</selector>
