<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/browserHeader"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:background="@drawable/header_background"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layoutDirection="ltr"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="SatLink"
                android:scaleType="centerCrop"
                android:src="@drawable/satlink_logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="SatLink Browser"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/proVersionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:background="@drawable/pro_badge_background"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp"
                android:text="PRO"
                android:textColor="#FF4B9F"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/browserTabsButton"
                android:layout_width="44dp"
                android:layout_height="38dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/toolbar_icon_background"
                android:contentDescription="التبويبات المفتوحة"
                android:gravity="center"
                android:text="▣ 1"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/headerExtensionsButton"
                android:layout_width="46dp"
                android:layout_height="36dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/toolbar_icon_background"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="7dp"
                android:text="🧩 0"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/headerMenuButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/toolbar_icon_background"
                android:gravity="center"
                android:text="⋮"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/browserToolbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layoutDirection="ltr"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/backButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/toolbar_icon_background"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="‹"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="27sp" />

            <Button
                android:id="@+id/forwardPageButton"
                android:layout_width="32dp"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/toolbar_icon_background"
                android:contentDescription="التقدم في سجل التبويب"
                android:enabled="false"
                android:alpha="0.4"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="›"
                android:textColor="#FFFFFF"
                android:textSize="25sp" />

            <Button
                android:id="@+id/refreshPageButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/toolbar_icon_background"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="↻"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <EditText
                android:id="@+id/addressBar"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/address_background"
                android:hint="ابحث أو أدخل عنوان الموقع"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:selectAllOnFocus="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#8E8798"
                android:textDirection="ltr"
                android:textSize="13sp" />

            <Button
                android:id="@+id/addFavoriteButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/toolbar_icon_background"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="♡+"
                android:textAllCaps="false"
                android:textColor="#FF4B9F"
                android:textSize="16sp" />

            <Button
                android:id="@+id/showFavoritesButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/toolbar_icon_background"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="♥"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <Button
                android:id="@+id/goButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/toolbar_icon_background"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="➜"
                android:textAllCaps="false"
                android:textColor="#FF4B9F"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progressDrawable="@drawable/progress_horizontal_neon"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#05050A">

        <org.mozilla.geckoview.GeckoView
            android:id="@+id/geckoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ScrollView
            android:id="@+id/homeOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#07070C"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="تصفّح بسرعة"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="end"
                    android:text="واجهة SatLink النظيفة بدون ترندات أو اقتراحات مزعجة"
                    android:textColor="#9E96A8"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/address_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">
                    <EditText
                        android:id="@+id/homeSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="ابحث أو أدخل عنوان الموقع"
                        android:imeOptions="actionGo"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:paddingHorizontal="12dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#8E8798"
                        android:textDirection="rtl"
                        android:textSize="14sp" />
                    <Button
                        android:id="@+id/homeGoButton"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/download_button_background"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:stateListAnimator="@null"
                        android:text="بحث"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="اضغط مطولاً لحذف اختصار"
                        android:textColor="#837B8B"
                        android:textSize="10sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="المواقع السريعة"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/shortcutGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/panel_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="التنزيلات\nإدارة الملفات التي تم تنزيلها"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <Button
                        android:id="@+id/homeDownloadsButton"
                        android:layout_width="96dp"
                        android:layout_height="42dp"
                        android:background="@drawable/download_button_background"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:stateListAnimator="@null"
                        android:text="فتح"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/downloadsOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#07070C"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/refreshDownloadsButton"
                    android:layout_width="90dp"
                    android:layout_height="1dp"
                    android:background="@drawable/download_button_background"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="تحديث"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="التنزيلات"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="end"
                android:text="Downloads/SatLink"
                android:textColor="#9E96A8"
                android:textSize="12sp" />
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1">
                <LinearLayout
                    android:id="@+id/downloadsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/extensionsOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#07070C"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="الإضافات"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:text="تظهر هنا إضافات Firefox المثبتة مثل uBlock Origin"
                android:textColor="#9E96A8"
                android:textSize="12sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/address_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="7dp">
                <EditText
                    android:id="@+id/extensionUrlInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="رابط إضافة Firefox بصيغة XPI"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8E8798"
                    android:textDirection="ltr"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/installExtensionButton"
                    android:layout_width="76dp"
                    android:layout_height="38dp"
                    android:background="@drawable/download_button_background"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="تثبيت"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <Button
                android:id="@+id/installExtensionFileButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/download_button_background"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:stateListAnimator="@null"
                android:text="＋ تثبيت إضافة XPI من مدير الملفات"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/openAddonsStoreButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/toolbar_icon_background"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="فتح متجر إضافات Firefox"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
                <Button
                    android:id="@+id/refreshExtensionsButton"
                    android:layout_width="84dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/toolbar_icon_background"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="تحديث"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1">
                <LinearLayout
                    android:id="@+id/extensionsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/favoritesOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#07070C"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layoutDirection="rtl"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="المفضلات"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/closeFavoritesButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/close_button_background"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="×"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/favoritesSearch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/address_background"
                android:hint="البحث في المفضلات..."
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8E8798"
                android:textDirection="rtl" />

            <TextView
                android:id="@+id/favoritesEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="لا توجد صفحات محفوظة في المفضلات"
                android:textColor="#AAA3B2"
                android:textSize="14sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1">
                <LinearLayout
                    android:id="@+id/favoritesList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabsOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#07070C"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="علامات التبويب"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/newTabButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/download_button_background"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:stateListAnimator="@null"
                android:text="＋ تبويب جديد"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/tabsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>

        <Button
            android:id="@+id/captureButton"
            android:visibility="gone"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/capture_button_background"
            android:elevation="12dp"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="⬇"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/capturePanel"
            android:layout_width="match_parent"
            android:layout_height="560dp"
            android:layout_gravity="bottom"
            android:background="@drawable/panel_background"
            android:elevation="20dp"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <View
                android:layout_width="42dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:background="#5D5365" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="rtl"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/captureTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="خيارات التحميل"
                        android:textColor="#FFFFFF"
                        android:textDirection="rtl"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/captureStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="3dp"
                        android:text="شغّل الفيديو ثم اضغط التقاط"
                        android:textColor="#AAA3B2"
                        android:textDirection="rtl"
                        android:textSize="11sp" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/analysisProgress"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:indeterminateTint="#FF2D87"
                    android:visibility="gone" />
                <Button
                    android:id="@+id/closeCaptureButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/close_button_background"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:stateListAnimator="@null"
                    android:text="×"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/videoHeader"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/video_header_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:layoutDirection="rtl"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="▤  الفيديو"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView android:id="@+id/videoCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 جودة" android:textColor="#D5CBD8" android:textSize="11sp" />
                <TextView android:id="@+id/videoArrow" android:layout_width="34dp" android:layout_height="wrap_content" android:gravity="center" android:text="⌄" android:textColor="#FF4B9F" android:textSize="24sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/videoScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:overScrollMode="never"
                android:visibility="gone">
                <LinearLayout android:id="@+id/videoResults" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="9dp" android:paddingBottom="3dp" />
            </ScrollView>

            <LinearLayout
                android:id="@+id/audioHeader"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/audio_header_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:layoutDirection="rtl"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="♫  الصوتيات MP3" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/audioCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 جودة" android:textColor="#D5CBD8" android:textSize="11sp" />
                <TextView android:id="@+id/audioArrow" android:layout_width="34dp" android:layout_height="wrap_content" android:gravity="center" android:text="⌄" android:textColor="#D95DFF" android:textSize="24sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/audioScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:overScrollMode="never"
                android:visibility="gone">
                <LinearLayout android:id="@+id/audioResults" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="9dp" android:paddingBottom="3dp" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@drawable/header_background"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="5dp">
        <TextView android:id="@+id/navTabs" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▣\nالتبويبات" android:textColor="#AEA6B4" android:textSize="10sp" />
        <TextView android:id="@+id/navDownloads" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⇩\nالتنزيلات" android:textColor="#AEA6B4" android:textSize="10sp" />
        <TextView android:id="@+id/navCapture" android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/capture_button_background" android:gravity="center" android:text="◎" android:textColor="#FFFFFF" android:textSize="25sp" android:textStyle="bold" />
        <TextView android:id="@+id/navExtensions" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="✚\nالإضافات" android:textColor="#AEA6B4" android:textSize="10sp" />
        <TextView android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⌂\nالرئيسية" android:textColor="#FF4B9F" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
